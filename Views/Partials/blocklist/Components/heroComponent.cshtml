@using Umbraco.Cms.Core.Models.Blocks;
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<BlockListItem>
@{
    var content = Model.Content;
    var title = content.Value<string>("title");
    var bgColor = content.Value<string>("bgColor") ?? "ffffff";
    var features = content.Value<IEnumerable<string>>("features") ?? Enumerable.Empty<string>();
    

    var pureHex = bgColor.Trim('#');
}

<div class="jumbotron" style="
    background: linear-gradient(145deg, rgba(255,255,255,0.6) 0%, rgba(0,0,0,0.15) 50%, rgba(255,255,255,0.4) 100%), #@pureHex;
    box-shadow: inset 0 2px 5px rgba(255,255,255,0.5), inset 0 -3px 5px rgba(0,0,0,0.3), 0 10px 20px rgba(0,0,0,0.15);
    border: 1px solid rgba(255,255,255,0.2);
    border-radius: 12px;
    padding: 60px 20px;
    position: relative;
    overflow: hidden;">
    
    <!-- Εφέ γυαλίάδας (Metallic Highlight Drop) -->
    <div style="position: absolute; top: 0; left: 0; right: 0; height: 50%; background: linear-gradient(to bottom, rgba(255,255,255,0.3) 0%, rgba(255,255,255,0) 100%); pointer-events: none;"></div>

    <div class="container text-center" style="position: relative; z-index: 1;">
        <h1 class="display-4" style="text-shadow: 0 2px 4px rgba(0,0,0,0.2); font-weight: bold;">@title</h1>
        <hr class="my-4" style="border-top: 1px solid rgba(0,0,0,0.1); border-bottom: 1px solid rgba(255,255,255,0.3);">
        
        <div class="d-flex justify-content-center gap-3 flex-wrap">
            @foreach (var feature in features)
            {
                <span class="badge p-2" style="
                    background: linear-gradient(135deg, #ffffff 0%, #e0e0e0 50%, #b5b5b5 100%);
                    color: #222; 
                    border: 1px solid #999;
                    box-shadow: inset 0 1px 0 rgba(255,255,255,0.8), 0 2px 4px rgba(0,0,0,0.15);
                    text-shadow: 0 1px 0 rgba(255,255,255,0.5);
                    font-weight: 600;
                    border-radius: 6px;">
                    @feature
                </span>
            }
        </div>
    </div>
</div>