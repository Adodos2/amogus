@using Umbraco.Cms.Web.Common.PublishedModels;
@using Umbraco.Cms.Core.Models.Blocks;
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<BlockListItem>
@{
    // Χρησιμοποιούμε το Model.Content απευθείας για να αποφύγουμε το Namespace Error
    var content = Model.Content;

    // ΣΗΜΑΝΤΙΚΟ: Βεβαιώσου ότι τα aliases ("...") είναι ίδια με αυτά που έβαλες στο Umbraco
    var headline = content.Value<string>("headline"); 
    var accentColor = content.Value<string>("accentColor") ?? "3498db"; 
    var image = content.Value<IPublishedContent>("mainImage");
}

<section class="container my-5 p-4" style="border-left: 5px solid #@accentColor.Trim('#'); background-color: #f8f9fa;">
    <div class="row align-items-center">
        <div class="col-md-6">
            <h2>@headline</h2>
            
            @if (image != null)
            {
                <div class="mt-3">
                    <img src="@image.Url()" class="img-fluid rounded shadow" alt="@headline" style="max-height: 250px;" />
                </div>
            }
        </div>
        
        <div class="col-md-6">
            <!-- Εδώ θα γίνει το render του Three.js -->
            <div id="canvas-3d" style="width: 100%; height: 400px; background: #eee; border-radius: 8px;"></div>
        </div>
    </div>
</section>

@* Φόρτωση του script *@
<script type="module" src="/scripts/three-scene.js"></script>