@using Umbraco.Cms.Web.Common.PublishedModels;
@using Umbraco.Cms.Core.Models.Blocks;
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<BlockListItem>
@{
    var content = Model.Content;
    var headline = content.Value<string>("headline"); 
    var accentColor = content.Value<string>("accentColor") ?? "3498db"; 
    var image = content.Value<IPublishedContent>("mainImage");
    var pureHex = accentColor.Trim('#');
}

<section class="container my-5 p-4" style="border-left: 5px solid #@pureHex; background-color: #f8f9fa; border-radius: 0 8px 8px 0; box-shadow: 0 4px 15px rgba(0,0,0,0.05);">
    <div class="row align-items-center">
        <div class="col-md-6">
            <h2>@headline</h2>
            
            @if (image != null)
            {
                <div class="mt-3">
                    <img src="@image.Url()" class="img-fluid rounded shadow" alt="@headline" style="max-height: 250px;" />
                </div>
            }
        </div>
        
        <div class="col-md-6">
            <div id="canvas-3d" data-color="#@pureHex" style="width: 100%; height: 400px; background: #1a1a1a; border-radius: 8px; overflow: hidden; box-shadow: inset 0 0 20px rgba(0,0,0,0.6);"></div>
        </div>
    </div>
</section>

@* Φόρτωση του script *@
<script type="module" src="/scripts/three-scene.js"></script>